---
import { absoluteUrl, withBase } from '../lib/url';

interface Props {
  /** 站点名，用于 og:site_name */
  siteName: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  /** 分享图尺寸，默认按 1200×630 的大卡片 */
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const {
  siteName,
  title,
  description,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

// Astro.site 来自 astro.config.mjs 里的 site，改域名只需要改那一处
const origin = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = absoluteUrl(image, origin.href);

// 分享图的类型和尺寸。社交平台不认 SVG，所以分享图必须是 PNG/JPG，
// 并且带上宽高，平台才知道怎么裁成大卡片（微信、Twitter 都看这个）。
const ext = image.split('.').pop()?.toLowerCase();
const MIME: Record<string, string> = {
  png: 'image/png',
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  webp: 'image/webp',
  svg: 'image/svg+xml',
};
const ogImageType = ext ? MIME[ext] : undefined;
const ogImageWidth = imageWidth;
const ogImageHeight = imageHeight;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{ogImageType && <meta property="og:image:type" content={ogImageType} />}
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#FDFAF4" />
<!-- 图标：.ico 给老浏览器和微信内置浏览器，svg 给现代浏览器，png 给 iOS 主屏 -->
<link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="sitemap" href={withBase('/sitemap.xml')} />
