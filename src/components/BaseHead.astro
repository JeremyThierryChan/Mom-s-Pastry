---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { absoluteUrl, withBase } from '../lib/url';

interface Props {
  /** 站点名，用于 og:site_name */
  siteName: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  /** 分享图尺寸，默认按 1200×630 的大卡片 */
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const {
  siteName,
  title,
  description,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

// Astro.site 来自 astro.config.mjs 里的 site，改域名只需要改那一处
const origin = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = absoluteUrl(image, origin.href);

// 分享图的类型和尺寸。社交平台不认 SVG，所以分享图必须是 PNG/JPG，
// 并且带上宽高，平台才知道怎么裁成大卡片（微信、Twitter 都看这个）。
const ext = image.split('.').pop()?.toLowerCase();
const MIME: Record<string, string> = {
  png: 'image/png',
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  webp: 'image/webp',
  svg: 'image/svg+xml',
};
const ogImageType = ext ? MIME[ext] : undefined;
const ogImageWidth = imageWidth;
const ogImageHeight = imageHeight;

/**
 * 图标的缓存比普通资源顽固得多：浏览器把 favicon 存在单独的库里，
 * 普通刷新、甚至关掉标签页重开，都不一定会重新请求，URL 不变就永远用旧的。
 * 所以给图标 URL 挂一个内容哈希 —— 图标文件一改，URL 就变，浏览器只能重新拉。
 */
function iconVersion(file: string): string {
  try {
    return createHash('sha1')
      .update(readFileSync(resolve(process.cwd(), 'public', file)))
      .digest('hex')
      .slice(0, 8);
  } catch {
    return '1';
  }
}

const icoVersion = iconVersion('favicon.ico');
const svgVersion = iconVersion('favicon.svg');
const appleVersion = iconVersion('apple-touch-icon.png');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<script is:inline>
  // 刷新后回到页顶，而不是停在浏览器「记住」的上次滚动位置。
  // 默认行为会让用户刷新时突然落到「关于笑笑」这类页面下半部分，
  // 单页落地页这样很别扭。
  //
  // 只在不带锚点时才接管：网址里如果有 #contact 这种锚点，
  // 就保持浏览器默认行为，刷新后仍然停在那个区块
  // （manual 模式会把「跳到锚点」也一起关掉，所以要区别对待）。
  if (!location.hash && 'scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }
</script>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{ogImageType && <meta property="og:image:type" content={ogImageType} />}
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#FDFAF4" />
<!-- 图标：.ico 给老浏览器和微信内置浏览器，svg 给现代浏览器，png 给 iOS 主屏。
     带内容哈希，避免浏览器一直用缓存的旧图标 -->
<link rel="icon" href={withBase(`/favicon.ico?v=${icoVersion}`)} sizes="32x32" />
<link rel="icon" href={withBase(`/favicon.svg?v=${svgVersion}`)} type="image/svg+xml" />
<link rel="apple-touch-icon" href={withBase(`/apple-touch-icon.png?v=${appleVersion}`)} />
<link rel="sitemap" href={withBase('/sitemap.xml')} />
