---
import type { SiteContent } from '../lib/content';
import { formatPrice } from '../lib/format';
import Photo from './Photo.astro';
import SectionHeading from './SectionHeading.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  compare: SiteContent['compare'];
  products: SiteContent['products']['items'];
}

const { compare, products } = Astro.props;

type Product = SiteContent['products']['items'][number];

/** 「价格 / 规格 / 状态」这种行直接显示文字，其余行按配料打勾 */
const TEXT_ROWS: Record<string, (product: Product) => string> = {
  价格: (product) => formatPrice(product.price, product.unit),
  规格: (product) => product.unit,
  状态: (product) => product.status,
};

/** 把「咸蛋黄、红豆沙」这种配料串拆干净，方便比对 */
function ingredientList(product: Product): string[] {
  return (product.ingredients ?? '')
    .split(/[、,，/|]/)
    .map((item) => item.trim())
    .filter(Boolean);
}

/**
 * 这个产品有没有这一项配料。
 * 用「包含」而不是「全等」，所以对比行写「蛋黄」也能匹配产品里的「咸蛋黄」。
 */
function hasIngredient(product: Product, row: string): boolean {
  return ingredientList(product).some((item) => item.includes(row) || row.includes(item));
}

/**
 * 表格最小宽度：左边 4.5rem 给行名（那一列吸顶），每款产品 8.25rem。
 * 8.25rem 不是随便定的：最长的产品名「笑笑经典蛋黄酥」7 个字，
 * 16px 字号下正好 112px，加上左右内边距要 124px 以上才不会折行。
 */
const minWidth = `${(4.5 + products.length * 8.25).toFixed(1)}rem`;
---

<section id="compare" class="section">
  <div class="wrap">
    <SectionHeading eyebrow={compare.eyebrow} title={compare.title} note={compare.note} />

    {
      products.length > 0 && (
        <div class="mt-10 md:mt-12">
          <p class="mb-3 text-xs text-clay sm:hidden" aria-hidden="true">
            ← 左右滑动看全部 · 左边配料名固定 →
          </p>

          {/* 手机放不下这么多列，就在这个容器里横向滑动。
              注意别用负边距做「整屏出血」——那样会让 html 的 scrollWidth 虚高，
              某些手机浏览器上会出现横向抖动。 */}
          <div class="overflow-x-auto">
            {/* table-fixed：列宽不由内容决定，否则产品名越长那一列越宽，
                五张缩略图就会大小不一。固定布局下所有产品列等宽 */}
            <table
                class="w-full table-fixed border-separate border-spacing-0 text-left"
                style={`min-width: ${minWidth}`}
              >
              <caption class="sr-only">{compare.title}</caption>

              <thead>
                <tr>
                  {/* 左上角空单元格：和行名一样吸顶，z 更高，压在两边之上 */}
                  <th scope="col" class="sticky left-0 z-20 w-16 bg-cream align-bottom sm:w-20" />
                  {products.map((product) => (
                    <th scope="col" class="px-1.5 pb-5 text-center align-bottom sm:px-2">
                      <Photo
                        src={product.image}
                        alt={product.imageAlt}
                        ratio="ratio-4-3"
                        frameClass="rounded-xl"
                      />
                      <span class="mt-3 block font-serif text-base leading-snug whitespace-nowrap text-ink">
                        {product.name}
                      </span>
                      <span class="mt-1.5 block font-serif text-sm text-yolk-deep">
                        {formatPrice(product.price, product.unit)}
                      </span>
                      <span class="mt-2 block">
                        <StatusBadge status={product.status} />
                      </span>
                    </th>
                  ))}
                </tr>
              </thead>

              <tbody>
                {compare.rows.map((row) => (
                  <tr>
                    <th
                      scope="row"
                      {/* 行名整列吸顶：手机横向滑动时配料名一直看得见。
                          必须给不透明底色，否则滑过去的内容会透出来。
                          右边一条细线，暗示下面还有内容。 */}
                        class="sticky left-0 z-10 border-t border-r border-line bg-cream py-3 pr-3 align-middle text-sm font-normal whitespace-nowrap text-clay sm:py-3.5 sm:pr-4"
                    >
                      {row}
                    </th>
                    {products.map((product) => {
                      const textRow = TEXT_ROWS[row];
                      if (textRow) {
                        return (
                          <td class="border-t border-line px-1.5 py-3 text-center align-middle text-sm text-cocoa sm:px-2 sm:py-3.5">
                            {textRow(product)}
                          </td>
                        );
                      }
                      const has = hasIngredient(product, row);
                      return (
                        <td class="border-t border-line px-1.5 py-3 text-center align-middle sm:px-2 sm:py-3.5">
                          <span class="sr-only">{has ? '有' : '没有'}</span>
                          {has ? (
                            <span
                              class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-yolk-soft text-[13px] leading-none font-bold text-yolk-deep"
                              aria-hidden="true"
                            >
                              ✓
                            </span>
                          ) : (
                            <span class="text-clay/45" aria-hidden="true">
                              —
                            </span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </div>
</section>
