---
import type { SiteContent } from '../lib/content';
import { formatPrice } from '../lib/format';
import Photo from './Photo.astro';
import SectionHeading from './SectionHeading.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  compare: SiteContent['compare'];
  products: SiteContent['products']['items'];
}

const { compare, products } = Astro.props;

/**
 * 某一行在某款产品上的显示值。
 * 行名就是产品里的字段名（见 网站内容.md 的「对比行：」），
 * 只有「价格」需要特殊处理 —— 产品里存的是数字，要拼成「¥15 / 1枚」。
 */
function valueOf(product: SiteContent['products']['items'][number], row: string): string {
  if (row === '价格') return formatPrice(product.price, product.unit);
  return product.fields[row] ?? '';
}

/**
 * 表格最小宽度：左边留 4.5rem 给行名，每款产品 8.7rem。
 * 产品多了表格就变宽、手机上的滑动距离也自动变长，不用手改。
 */
const minWidth = `${(4.5 + products.length * 8.7).toFixed(1)}rem`;
---

<section id="compare" class="section">
  <div class="wrap">
    <SectionHeading eyebrow={compare.eyebrow} title={compare.title} note={compare.note} />

    {
      products.length > 0 && (
        <div class="mt-10 md:mt-12">
          <p class="mb-3 text-xs text-clay sm:hidden" aria-hidden="true">
            ← 左右滑动看全部 →
          </p>

          {/* 手机放不下四列，就在这个容器里横向滑动；页面本身不会横向滚动 */}
          <div class="-mx-5 overflow-x-auto px-5 sm:mx-0 sm:px-0">
            <table
              class="w-full border-collapse text-left"
              style={`min-width: ${minWidth}`}
            >
              <caption class="sr-only">{compare.title}</caption>

              <thead>
                <tr>
                  <th scope="col" class="w-16 align-bottom sm:w-20" />
                  {products.map((product) => (
                    <th scope="col" class="px-2 pb-5 align-bottom sm:px-3">
                      <Photo
                        src={product.image}
                        alt={product.imageAlt}
                        aspect="aspect-[4/3]"
                        frameClass="rounded-xl"
                      />
                      <span class="mt-3 block font-serif text-base leading-snug text-ink">
                        {product.name}
                      </span>
                      <span class="mt-2 block">
                        <StatusBadge status={product.status} />
                      </span>
                    </th>
                  ))}
                </tr>
              </thead>

              <tbody>
                {compare.rows.map((row) => (
                  <tr class="border-t border-line">
                    <th
                      scope="row"
                      class="py-4 pr-3 align-top text-sm font-normal whitespace-nowrap text-clay sm:pr-4"
                    >
                      {row}
                    </th>
                    {products.map((product) => (
                      <td class="px-2 py-4 align-top text-sm leading-relaxed text-cocoa sm:px-3">
                        {valueOf(product, row)}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </div>
</section>
