---
import type { SiteContent } from '../lib/content';
import Photo from './Photo.astro';

interface Props {
  about: SiteContent['about'];
}

const { about } = Astro.props;
---

<section id="about" class="section">
  <div class="wrap">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12 lg:gap-16">
      <Photo src={about.image} alt={about.imageAlt} ratio="ratio-4-3 md-ratio-4-5" />

      <div>
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 class="section-title mt-4">{about.title}</h2>
        <!-- 正文来自「网站内容.md › 关于笑笑」，是按 Markdown 渲染好的 -->
        <div class="prose-handmade mt-6" set:html={about.html} />
      </div>
    </div>
  </div>
</section>
