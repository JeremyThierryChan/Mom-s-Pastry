---
import type { Product } from '../lib/content';
import { formatPrice } from '../lib/format';
import Photo from './Photo.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, description, price, unit, status, image, imageAlt, note } = product.data;
---

<article class="card flex h-full w-full flex-col overflow-hidden">
  <Photo src={image} alt={imageAlt} aspect="aspect-[4/3]" frameClass="rounded-none border-0" />
  <div class="flex flex-1 flex-col p-5">
    <div>
      <StatusBadge status={status} />
    </div>
    <h3 class="mt-3 font-serif text-lg leading-snug">{name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-clay">{description}</p>
    {note && <p class="mt-2 text-xs leading-relaxed text-clay/80">{note}</p>}
    <p class="mt-auto border-t border-line pt-4 font-serif text-base text-ink">
      <span class="sr-only">价格：</span>
      {formatPrice(price, unit)}
    </p>
  </div>
</article>
