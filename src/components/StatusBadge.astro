---
import { statusTone, type StatusTone } from '../lib/content';

interface Props {
  /** 状态原文，直接来自 网站内容.md，例如「今日可订」 */
  status: string;
}

const { status } = Astro.props;
const tone = statusTone(status);

/** 状态配色全部落在暖色系里，避免电商平台那种高饱和色块 */
const TONES: Record<StatusTone, { badge: string; dot: string }> = {
  available: { badge: 'border-[#f0dfae] bg-[#fbf0d2] text-[#8a6212]', dot: 'bg-[#e4a82e]' },
  limited: { badge: 'border-[#ebd6be] bg-[#f7e9da] text-[#8a5a2b]', dot: 'bg-[#c98a4b]' },
  soldout: { badge: 'border-[#e3ddd2] bg-[#f2eee7] text-[#8a7b68]', dot: 'bg-[#b6a892]' },
};

const style = TONES[tone];
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-2.5 py-1 text-xs leading-none font-medium',
    style.badge,
  ]}
>
  <span class:list={['mr-1.5 h-1.5 w-1.5 rounded-full', style.dot]} aria-hidden="true"></span>
  {status}
</span>
