---
import type { SiteContent } from '../lib/content';
import Photo from './Photo.astro';

interface Props {
  site: SiteContent;
}

const { site } = Astro.props;
const hero = site.hero;
---

<section class="pt-10 pb-2 sm:pt-14 md:pt-20">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="display-title mt-5">{hero.title}</h1>
      <p class="mt-4 font-serif text-lg text-clay sm:text-xl">{hero.subtitle}</p>
      <p class="mt-6 max-w-xl text-base leading-relaxed sm:text-lg">{hero.intro}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="btn btn-primary" href="#today">{hero.ctaLabel}</a>
        <a class="btn btn-ghost" href="#about">{hero.ctaSecondaryLabel}</a>
      </div>
    </div>

    <div class="mt-10 md:mt-14">
      <Photo
        src={hero.image}
        alt={hero.imageAlt}
        ratio="ratio-4-3 md-ratio-16-9"
        loading="eager"
      />
    </div>
  </div>
</section>
