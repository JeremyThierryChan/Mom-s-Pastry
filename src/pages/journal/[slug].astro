---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import { SITE } from '../../consts';
import { getJournal, journalHref, journalSlug, type JournalEntry } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/format';
import { withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  const entries = await getJournal();
  return entries.map((entry) => ({
    params: { slug: journalSlug(entry.id) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: JournalEntry;
}

const { entry } = Astro.props;
const { title, date, summary, image, imageAlt } = entry.data;
const { Content } = await render(entry);

const all = await getJournal();
const index = all.findIndex((item) => item.id === entry.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;
---

<BaseLayout
  title={`${title}｜${SITE.name}`}
  description={summary}
  image={image}
  type="article"
  publishedTime={date.toISOString()}
>
  <article class="py-10 sm:py-14">
    <div class="wrap max-w-2xl">
      <a class="inline-block py-1.5 text-sm text-clay hover:text-ink" href={withBase('/#journal')}
        >← 返回手作记录</a
      >

      <time class="mt-8 block text-xs tracking-[0.15em] text-clay" datetime={isoDate(date)}>
        {formatDate(date)}
      </time>
      <h1 class="mt-3 font-serif text-3xl leading-snug sm:text-4xl">{title}</h1>

      {
        image && (
          <div class="mt-8">
            <Photo src={image} alt={imageAlt ?? title} aspect="aspect-[16/10]" loading="eager" />
          </div>
        )
      }

      <div class="prose-handmade mt-10">
        <Content />
      </div>

      <nav class="mt-14 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label="上下篇">
        {
          newer ? (
            <a class="card p-5 transition-shadow hover:shadow-lift" href={withBase(journalHref(newer.id))}>
              <span class="text-xs text-clay">更新的记录</span>
              <span class="mt-2 block font-serif text-base text-ink">{newer.data.title}</span>
            </a>
          ) : (
            <span></span>
          )
        }
        {
          older ? (
            <a
              class="card p-5 transition-shadow hover:shadow-lift sm:text-right"
              href={withBase(journalHref(older.id))}
            >
              <span class="text-xs text-clay">更早的记录</span>
              <span class="mt-2 block font-serif text-base text-ink">{older.data.title}</span>
            </a>
          ) : (
            <span></span>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>
