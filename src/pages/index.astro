---
import AboutSection from '../components/AboutSection.astro';
import FeedbackSection from '../components/FeedbackSection.astro';
import BookingSection from '../components/BookingSection.astro';
import CompareSection from '../components/CompareSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import JournalCard from '../components/JournalCard.astro';
import ProductGrid from '../components/ProductGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getJournal, getSite } from '../lib/content';
import { absoluteUrl } from '../lib/url';

const site = await getSite();
const journal = (await getJournal()).slice(0, site.journal.limit);
const origin = Astro.site ?? new URL('http://localhost:4321');

/** 给搜索引擎一点结构化信息，同时说明这是个小铺子而不是大平台 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand.name,
  slogan: site.brand.intro,
  description: site.brand.pageDescription,
  url: absoluteUrl('/', origin),
  image: absoluteUrl(site.brand.ogImage, origin),
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Hero site={site} />

  <section id="today" class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow={site.products.eyebrow}
        title={site.products.title}
        note={site.products.note}
      />
      <ProductGrid products={site.products.items} class="mt-10 md:mt-12" />
    </div>
  </section>

  {
    site.compare.visible && (
      <CompareSection compare={site.compare} products={site.products.items} />
    )
  }

  <AboutSection about={site.about} />

  {/* 顾客反馈放在「关于笑笑」之后：先讲人，再让顾客说话，最后才是联系下单 */}
  {site.feedback.visible && <FeedbackSection feedback={site.feedback} />}
  {
    site.journal.visible && (
      <section id="journal" class="section border-y border-line bg-sand/50">
        <div class="wrap">
          <SectionHeading
            eyebrow={site.journal.eyebrow}
            title={site.journal.title}
            note={site.journal.note}
          />
          <ul class="mt-10 grid gap-5 sm:grid-cols-2 sm:gap-6 md:mt-12 lg:grid-cols-3">
            {journal.map((entry) => (
              <JournalCard entry={entry} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ContactSection contact={site.contact} />

  {/* 预订须知放在最后：先看有什么、谁做的、别人怎么说，然后是联系方式，
      规则作为下单前的补充说明收尾 */}
  {site.booking.visible && <BookingSection booking={site.booking} />}
</BaseLayout>
